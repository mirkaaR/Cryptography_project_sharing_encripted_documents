{
  "name": "secure-storage-dapp",
  "version": "1.0.0",
  "description": "Decentralized app for secure encrypted document storage and sharing on Ethereum (Hardhat + React frontend).",
  "main": "index.js",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "node": "npx hardhat node",
    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "npx hardhat run scripts/deploy.js --network sepolia",
    "frontend": "cd frontend && npm start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirkaaR/Cryptography_project_sharing_encripted_documents.git"
  },
  "keywords": [
    "ethereum",
    "dapp",
    "hardhat",
    "ipfs",
    "blockchain",
    "encryption",
    "secure-storage"
  ],
  "author": "Mirjana Radić",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mirkaaR/Cryptography_project_sharing_encripted_documents/issues"
  },
  "homepage": "https://github.com/mirkaaR/Cryptography_project_sharing_encripted_documents#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "chai": "^4.3.7",
    "dotenv": "^17.2.3",
    "hardhat": "^2.26.3",
    "mocha": "^10.7.3"
  },
  "dependencies": {
    "ethers": "^6.11.1"
  }
}
